{
  "name": "agentswitch",
  "version": "0.1.3",
  "description": "One desktop chat for Claude Code, Codex CLI and Gemini (Antigravity CLI)",
  "homepage": "https://agentswitch.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yitian-builds/AgentSwitch.git"
  },
  "bugs": {
    "url": "https://github.com/yitian-builds/AgentSwitch/issues"
  },
  "main": "./out/main/index.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "node scripts/postinstall.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "app.agentswitch.desktop",
    "productName": "AgentSwitch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "AgentSwitch ${version}",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "afterPack": "scripts/afterPack.cjs"
  }
}
