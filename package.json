{
  "name": "agentswitch",
  "version": "0.1.9",
  "description": "One desktop chat for Claude Code, Codex CLI and Gemini (Antigravity CLI)",
  "homepage": "https://agentswitch.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yitian-builds/AgentSwitch.git"
  },
  "bugs": {
    "url": "https://github.com/yitian-builds/AgentSwitch/issues"
  },
  "main": "./out/main/index.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "node scripts/postinstall.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist": "node scripts/prepare-runtime.mjs --arch arm64 && electron-vite build && electron-builder --mac --arm64",
    "dist:app": "node scripts/prepare-runtime.mjs --arch arm64 && electron-vite build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "fdir": "^6.5.0",
    "fuzzysort": "^4.0.2",
    "ignore": "^7.0.16",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.13.0",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@electron/rebuild": "^4.2.1",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "app.agentswitch.desktop",
    "productName": "AgentSwitch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      "LICENSE",
      {
        "from": "build/runtime/${os}-${arch}",
        "to": "runtime"
      },
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleIconName": "AppIcon"
      },
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "AgentSwitch ${version}",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "afterPack": "scripts/afterPack.cjs"
  }
}
